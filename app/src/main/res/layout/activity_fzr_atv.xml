<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <pl.droidsonroids.gif.GifImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/fundo1080" />

    <ImageView
        android:id="@+id/BarraSuperior"
        android:layout_width="0dp"
        android:layout_height="90dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <ImageView
        android:id="@+id/btnVoltar"
        android:layout_width="52dp"
        android:layout_height="49dp"
        android:src="@drawable/voltar"
        android:gravity="center"
        android:paddingLeft="15dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/BarraSuperior"
        app:layout_constraintVertical_bias="0.792"
        app:layout_constraintHorizontal_bias="0.1"/>

    <TextView
        android:id="@+id/NomeTela"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/allerta"
        android:shadowColor="#004d41"
        android:shadowRadius="7"
        android:text="Fazer Atividade"
        android:textAlignment="center"
        android:textColor="#00A88F"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/BarraSuperior"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/BarraSuperior"
        app:layout_constraintVertical_bias="0.792" />

    <LinearLayout
        android:layout_width="359dp"
        android:layout_height="wrap_content"
        android:background="@drawable/card_bg"
        android:orientation="vertical"
        android:padding="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.55">

        <Spinner
            android:id="@+id/spinnerCriancas"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/input_bg"
            android:textColor="#A0F0E8"
            android:textColorHint="#A0F0E8"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerAtividades"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#A0F0E8"
            android:textStyle="bold"
            android:fontFamily="@font/allerta"
            android:layout_marginTop="15dp"
            android:background="@drawable/input_bg" />

        <EditText
            android:id="@+id/edtResposta"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="15dp"
            android:background="@drawable/input_bg"
            android:fontFamily="@font/allerta"
            android:hint="Digite a resposta"
            android:paddingLeft="18dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#A0F0E8"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/btnEnviar"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/allerta"
            android:background="@drawable/button_bg"
            android:text="Enviar"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            app:backgroundTint="@null" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>