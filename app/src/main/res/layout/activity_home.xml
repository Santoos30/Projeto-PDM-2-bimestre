<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".HomeActivity">


    <pl.droidsonroids.gif.GifImageView
        android:id="@+id/gifImageView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/fundo1080" />

    <ImageView
        android:id="@+id/BarraSuperior"
        android:layout_width="0dp"
        android:layout_height="90dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <ImageView
        android:id="@+id/btnVoltar"
        android:layout_width="52dp"
        android:layout_height="49dp"
        android:src="@drawable/voltar"
        android:gravity="center"
        android:paddingLeft="15dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/BarraSuperior"
        app:layout_constraintVertical_bias="0.792"
        app:layout_constraintHorizontal_bias="0.1"/>

    <TextView
        android:id="@+id/NomeTela"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/allerta"
        android:shadowColor="#004d41"
        android:shadowRadius="7"
        android:text="M.I.K.S.™"
        android:textAlignment="center"
        android:textColor="#00A88F"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/BarraSuperior"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/BarraSuperior"
        app:layout_constraintVertical_bias="0.792" />

    <LinearLayout
        android:id="@+id/containerBotoes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/PostCriancas"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:layout_margin="5dp"
                android:src="@drawable/post_crian"
                android:scaleType="fitXY"/>

            <ImageView
                android:id="@+id/GetCriancas"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:layout_margin="8dp"
                android:src="@drawable/get_crian"
                android:scaleType="fitXY"/>

        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/PostAtividades"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:layout_margin="5dp"
                android:src="@drawable/post_atv"
                android:scaleType="fitXY"/>

            <ImageView
                android:id="@+id/FzrAtividades"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:layout_margin="5dp"
                android:src="@drawable/fazer_atv"
                android:scaleType="fitXY"/>

        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/GetAtividades"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:layout_margin="5dp"
                android:src="@drawable/get_atv"
                android:scaleType="fitXY"/>

            <ImageView
                android:id="@+id/Historico"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:layout_margin="5dp"
                android:src="@drawable/historico"
                android:scaleType="fitXY"/>


        </LinearLayout>

        <ImageView
            android:id="@+id/btnSpotify"
            android:layout_width="280dp"
            android:layout_height="140dp"
            android:layout_margin="5dp"
            android:src="@drawable/buscar_musicas"
            android:scaleType="fitXY"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>